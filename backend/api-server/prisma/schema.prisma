generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  RIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum RiderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OnlineStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum BookingStatus {
  POOLING
  SEARCHING
  ACCEPTED
  RIDER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  WALLET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DocumentType {
  LICENSE
  REGISTRATION
  INSURANCE
  NBI_CLEARANCE
  MEDICAL_CERT
  PROFILE_PHOTO
  TRICYCLE_PHOTO
  TRICYCLE_FRONT
  TRICYCLE_BACK
  TRICYCLE_LEFT
  TRICYCLE_RIGHT
}

enum NotificationType {
  BOOKING_REQUEST
  RIDER_ASSIGNED
  RIDER_ARRIVED
  TRIP_STARTED
  TRIP_COMPLETED
  PAYMENT_RECEIVED
  PROMO_ALERT
  SYSTEM
  TOPUP_APPROVED
  TOPUP_REJECTED
}

enum TopupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PromoType {
  PERCENTAGE
  FIXED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum VehicleType {
  TRICYCLE
  DELIVERY
}

enum BookingType {
  RIDE
  REGULAR
  DELIVERY
  PABILI
}

model User {
  id               String     @id @default(uuid())
  phone            String     @unique
  email            String?    @unique
  firstName        String
  lastName         String
  passwordHash     String
  role             UserRole   @default(PASSENGER)
  status           UserStatus @default(PENDING_VERIFICATION)
  profilePhoto       String?
  validIdUrl         String?
  verificationStatus String  @default("UNVERIFIED")
  fcmToken           String?
  refreshTokenHash String?
  otpCode          String?
  otpExpiresAt     DateTime?
  loyaltyPoints    Int        @default(0)
  city             String?
  barangay         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  rider            RiderProfile?
  bookingsAsPassenger Booking[] @relation("PassengerBookings")
  notifications    Notification[]
  sentMessages     ChatMessage[]  @relation("SenderMessages")
  supportTickets   SupportTicket[] @relation("UserTickets")
  complaints       Complaint[]     @relation("UserComplaints")
  reportedIn       Complaint[]     @relation("ReportedComplaints")
  pointTransactions PointTransaction[]
  auditLogs        AuditLog[]

  @@map("users")
}

model RiderProfile {
  id                  String       @id @default(uuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id])
  status              RiderStatus  @default(PENDING)
  onlineStatus        OnlineStatus @default(OFFLINE)
  licenseNumber       String       @unique
  rating              Float        @default(5.0)
  totalTrips          Int          @default(0)
  walletBalance       Decimal      @default(0) @db.Decimal(10, 2)
  promoDebt           Decimal      @default(0) @db.Decimal(10, 2)
  currentLatitude     Float?
  currentLongitude    Float?
  vehicleType         VehicleType  @default(TRICYCLE)
  currentHeading      Float?
  currentSpeed        Float?
  lastLocationUpdate  DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  vehicle             Vehicle?
  documents           RiderDocument[]
  bookingsAsRider     Booking[]    @relation("RiderBookings")
  walletTransactions  WalletTransaction[]
  earnings            Earning[]
  ratings             Rating[]     @relation("RiderRatings")
  topupRequests       TopupRequest[]

  @@map("rider_profiles")
}

model Vehicle {
  id          String   @id @default(uuid())
  riderId     String   @unique
  rider       RiderProfile @relation(fields: [riderId], references: [id])
  plateNumber String   @unique
  brand       String
  model       String
  year        Int
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("vehicles")
}

model RiderDocument {
  id        String       @id @default(uuid())
  riderId   String
  rider     RiderProfile @relation(fields: [riderId], references: [id])
  type      DocumentType
  fileUrl   String
  verified  Boolean      @default(false)
  verifiedAt DateTime?
  createdAt DateTime     @default(now())

  @@unique([riderId, type])
  @@map("rider_documents")
}

model Booking {
  id                  String        @id @default(uuid())
  passengerId         String
  passenger           User          @relation("PassengerBookings", fields: [passengerId], references: [id])
  riderId             String?
  rider               RiderProfile? @relation("RiderBookings", fields: [riderId], references: [id])
  status              BookingStatus @default(SEARCHING)
  bookingType         BookingType   @default(RIDE)
  packageDescription  String?
  pickupContactName   String?
  pickupContactPhone  String?
  recipientName       String?
  recipientPhone      String?
  storeAddress        String?
  shoppingList        String?
  itemBudget          Decimal?      @db.Decimal(10, 2)
  pickupAddress       String
  pickupLatitude      Float
  pickupLongitude     Float
  pickupPlaceId       String?
  dropoffAddress      String
  dropoffLatitude     Float
  dropoffLongitude    Float
  dropoffPlaceId      String?
  distanceKm          Float
  estimatedMinutes    Int
  baseFare            Decimal       @db.Decimal(10, 2)
  distanceFare        Decimal       @db.Decimal(10, 2)
  timeFare            Decimal       @db.Decimal(10, 2)
  surgeMultiplier     Float         @default(1.0)
  discount            Decimal       @default(0) @db.Decimal(10, 2)
  estimatedFare       Decimal       @db.Decimal(10, 2)
  finalFare           Decimal?      @db.Decimal(10, 2)
  passengerCount      Int           @default(1)
  paymentMethod       PaymentMethod @default(CASH)
  promoCode           String?
  notes               String?
  cancellationReason  String?
  poolGroupId         String?
  poolExpiresAt       DateTime?
  acceptedAt          DateTime?
  arrivedAt           DateTime?
  pickedUpAt          DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  payment             Payment?
  tripLocations       TripLocation[]
  rating              Rating?
  chatMessages        ChatMessage[]

  @@index([passengerId, status])
  @@index([riderId, status])
  @@index([status, createdAt])
  @@index([poolGroupId])
  @@map("bookings")
}

model TripLocation {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  latitude  Float
  longitude Float
  heading   Float?
  speed     Float?
  timestamp DateTime @default(now())

  @@index([bookingId, timestamp])
  @@map("trip_locations")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String?       @unique
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  passengerId     String
  riderId         String
  amount          Decimal       @db.Decimal(10, 2)
  commission      Decimal?      @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  referenceNumber String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

model AdminSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

model RevenueTotal {
  period          String    @id
  revenue         Decimal   @default(0) @db.Decimal(10, 2)
  commission      Decimal   @default(0) @db.Decimal(10, 2)
  tripCount       Int       @default(0)
  periodStartedAt DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("revenue_totals")
}

model WalletTransaction {
  id          String                @id @default(uuid())
  riderId     String
  rider       RiderProfile          @relation(fields: [riderId], references: [id])
  amount      Decimal               @db.Decimal(10, 2)
  type        WalletTransactionType
  description String
  referenceId String?
  createdAt   DateTime              @default(now())

  @@map("wallet_transactions")
}

model TopupRequest {
  id              String              @id @default(uuid())
  riderId         String
  rider           RiderProfile        @relation(fields: [riderId], references: [id])
  amount          Decimal             @db.Decimal(10, 2)
  receiptUrl      String
  referenceNumber String?
  ocrAmount       Decimal?            @db.Decimal(10, 2)
  status          TopupRequestStatus  @default(PENDING)
  rejectionReason String?
  createdAt       DateTime            @default(now())
  reviewedAt      DateTime?

  @@index([riderId, status])
  @@map("topup_requests")
}

model Earning {
  id        String       @id @default(uuid())
  riderId   String
  rider     RiderProfile @relation(fields: [riderId], references: [id])
  bookingId String
  amount    Decimal      @db.Decimal(10, 2)
  date      DateTime     @default(now())

  @@index([riderId, date])
  @@map("earnings")
}

model Rating {
  id          String       @id @default(uuid())
  bookingId   String       @unique
  booking     Booking      @relation(fields: [bookingId], references: [id])
  riderId     String
  rider       RiderProfile @relation("RiderRatings", fields: [riderId], references: [id])
  passengerId String
  riderScore  Int
  passengerScore Int?
  riderComment   String?
  passengerComment String?
  createdAt   DateTime     @default(now())

  @@map("ratings")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model ChatMessage {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  senderId   String
  sender     User     @relation("SenderMessages", fields: [senderId], references: [id])
  message    String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([bookingId, createdAt])
  @@map("chat_messages")
}

model FareConfiguration {
  id                   String   @id @default(uuid())
  name                 String
  baseFare             Decimal  @db.Decimal(10, 2)
  ratePerKm            Decimal  @db.Decimal(10, 2)
  ratePerMinute        Decimal  @db.Decimal(10, 2)
  minimumFare          Decimal  @db.Decimal(10, 2)
  peakSurge            Float    @default(1.5)
  nightSurge           Float    @default(1.2)
  // Delivery (Lalamove-style motorcycle)
  deliveryBaseFare     Decimal  @default(80) @db.Decimal(10, 2)
  deliveryRatePerKm    Decimal  @default(12) @db.Decimal(10, 2)
  // Pabili (Grab Pabili-style)
  pabiliBaseFare       Decimal  @default(60) @db.Decimal(10, 2)
  pabiliRatePerKm      Decimal  @default(10) @db.Decimal(10, 2)
  pabiliServiceFee     Decimal  @default(20) @db.Decimal(10, 2)
  // Regular (pooled shared tricycle)
  regularBaseFare      Decimal  @default(15) @db.Decimal(10, 2)
  regularRatePerKm     Decimal  @default(10) @db.Decimal(10, 2)
  // Commission
  commissionRate       Float    @default(0.20)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("fare_configurations")
}

model Promotion {
  id            String    @id @default(uuid())
  code          String    @unique
  type          PromoType
  value         Decimal   @db.Decimal(10, 2)
  minFare       Decimal?  @db.Decimal(10, 2)
  maxDiscount   Decimal?  @db.Decimal(10, 2)
  usageLimit    Int?
  usageCount    Int       @default(0)
  userLimit     Int       @default(1)
  isActive      Boolean   @default(true)
  startsAt      DateTime
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  usages        PromoUsage[]

  @@map("promotions")
}

model PromoUsage {
  id          String    @id @default(uuid())
  promoId     String
  promo       Promotion @relation(fields: [promoId], references: [id])
  userId      String
  bookingId   String
  usedAt      DateTime  @default(now())

  @@unique([promoId, userId, bookingId])
  @@map("promo_usages")
}

model SupportTicket {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation("UserTickets", fields: [userId], references: [id])
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  replies     SupportReply[]

  @@map("support_tickets")
}

model SupportReply {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  authorId  String
  message   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@map("support_replies")
}

model Complaint {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("UserComplaints", fields: [userId], references: [id])
  reportedUserId  String?
  reportedUser    User?    @relation("ReportedComplaints", fields: [reportedUserId], references: [id])
  bookingId       String?
  userType        String
  type            String
  details         String
  status          String   @default("PENDING")
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userType, createdAt])
  @@map("complaints")
}

model PointTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  points      Int
  type        String   // EARN, REDEEM_TOPUP, REDEEM_DISCOUNT
  description String
  bookingId   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("point_transactions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
