{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tamarrawgo-backend-v2-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://tamarrawgo-backend-v2-production.up.railway.app"
      }
    },
    "production": {
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tamarrawgo-backend-v2-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://tamarrawgo-backend-v2-production.up.railway.app"
      }
    }
  }
}
