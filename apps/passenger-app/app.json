{
  "expo": {
    "name": "TamarrawGo",
    "slug": "tamarrawgo-passenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/passenger-app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B6B2F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tamarrawgo.passenger",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TamarrawGo needs your location to find nearby riders and show your position on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TamarrawGo needs your location for real-time trip tracking.",
        "NSLocationAlwaysUsageDescription": "TamarrawGo needs your location for real-time trip tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/passenger-app-icon.png",
        "backgroundColor": "#1B6B2F"
      },
      "package": "com.tamarrawgo.passenger",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B00"
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "tamarrawgo",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af91fb9a-6193-4578-a07e-08609f2a740d"
      }
    },
    "owner": "kummiiiiii"
  }
}
