{
  "name": "tamarrawgo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend/api-server",
    "dev:admin": "npm run dev --workspace=apps/admin-dashboard",
    "build:backend": "npm run build --workspace=backend/api-server",
    "build:admin": "npm run build --workspace=apps/admin-dashboard",
    "db:generate": "npm run prisma:generate --workspace=backend/api-server",
    "db:migrate": "npm run prisma:migrate --workspace=backend/api-server",
    "db:studio": "npm run prisma:studio --workspace=backend/api-server",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "babel-preset-expo": "^56.0.12",
    "expo": "^54.0.34",
    "expo-asset": "~11.0.0",
    "expo-router": "~6.0.0",
    "metro-runtime": "^0.84.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5"
  }
}
